{
  "name": "yummyfi-monorepo",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && vite",
    "dev:web": "cd apps/web && vite",
    "dev:mobile": "cd apps/mobile && npm start",
    "build": "npm run build:packages && cd apps/web && vite build",
    "build:packages": "npm run build:types && npm run build:firebase",
    "build:types": "cd packages/types && npm run build",
    "build:firebase": "cd packages/firebase && npm run build",
    "lint": "eslint .",
    "lint:dualite": "eslint --config eslint.dualite.config.js .",
    "tsc:dualite": "yarn tsc -p tsconfig.dualite.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@imagekit/javascript": "^5.2.1",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  }
}
